{
  "expo": {
    "name": "FishLog",
    "slug": "fishlog-fe",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fishlog",
    "userInterfaceStyle": "light",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAFC"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
