+﻿package net.mjstudio.rnkakao.map
+
+import com.facebook.react.bridge.ReadableArray
+import com.facebook.react.bridge.ReadableMap
+import com.facebook.react.uimanager.BaseViewManagerDelegate
+import com.facebook.react.uimanager.ThemedReactContext
+import com.facebook.react.uimanager.ViewManagerDelegate
+import com.facebook.react.uimanager.SimpleViewManager
+import com.facebook.react.viewmanagers.RNCKakaoMapViewManagerDelegate
+import com.facebook.react.viewmanagers.RNCKakaoMapViewManagerInterface
+import com.kakao.vectormap.MapType
+import com.kakao.vectormap.PoiScale
+
+internal class RNCKakaoMapViewManager : SimpleViewManager<RNCKakaoMapView>(), RNCKakaoMapViewManagerInterface<RNCKakaoMapView> {
+  private val delegate: ViewManagerDelegate<RNCKakaoMapView> = RNCKakaoMapViewManagerDelegate(this)
+
+  override fun getName() = "RNCKakaoMapView"
+  override fun getDelegate(): ViewManagerDelegate<RNCKakaoMapView> = delegate
+  override fun createViewInstance(context: ThemedReactContext) = RNCKakaoMapView(context)
+  override fun onDropViewInstance(view: RNCKakaoMapView) { view.destroy(); super.onDropViewInstance(view) }
+
+  override fun setBuildingScale(view: RNCKakaoMapView, value: Double) { view.buildingScale = value.toFloat() }
+  override fun setOverlays(view: RNCKakaoMapView, value: ReadableArray?) = Unit
+  override fun setPoiEnabled(view: RNCKakaoMapView, value: Boolean) { view.poiEnabled = value }
+  override fun setPoiClickable(view: RNCKakaoMapView, value: Boolean) { view.poiClickable = value }
+  override fun setPoiScale(view: RNCKakaoMapView, value: String?) { view.poiScale = runCatching { PoiScale.valueOf(value?.uppercase() ?: "REGULAR") }.getOrDefault(PoiScale.REGULAR) }
+  override fun setLanguage(view: RNCKakaoMapView, value: String?) { view.language = value ?: "ko" }
+  override fun setBaseMapType(view: RNCKakaoMapView, value: String?) { view.mapType = if (value.equals("skyview", true)) MapType.SKYVIEW else MapType.NORMAL }
+  override fun setCamera(view: RNCKakaoMapView, value: ReadableMap?) { value?.toCamera()?.let(view::setCamera) }
+  override fun setInitialCamera(view: RNCKakaoMapView, value: ReadableMap?) { value?.toCamera()?.let(view::setCamera) }
+  override fun setCameraMinLevel(view: RNCKakaoMapView, value: Double) { view.cameraMinLevel = value.toInt() }
+  override fun setCameraMaxLevel(view: RNCKakaoMapView, value: Double) { view.cameraMaxLevel = value.toInt() }
+  override fun setCameraAnimationDuration(view: RNCKakaoMapView, value: Double) { view.cameraAnimationDuration = value.toInt() }
+  override fun setIsShowScaleBar(view: RNCKakaoMapView, value: Boolean) { view.showScaleBar = value }
+  override fun setIsShowCompass(view: RNCKakaoMapView, value: Boolean) { view.showCompass = value }
+
+  private fun ReadableMap.toCamera() = CameraProps(
+    latitude = getDouble("lat"),
+    longitude = getDouble("lng"),
+    zoomLevel = if (hasKey("zoomLevel")) getDouble("zoomLevel").toInt() else 15,
+  )
+}
+
