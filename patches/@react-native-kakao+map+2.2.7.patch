+/** 마커를 눌렀을 때 JS 로 올려 보내는 이벤트. onSpotPress 로 도착한다. */
+internal class SpotPressEvent(surfaceId: Int, viewId: Int, private val spotId: String) :
+  Event<SpotPressEvent>(surfaceId, viewId) {
+  override fun getEventName() = EVENT_NAME
+
+  override fun getEventData(): WritableMap = Arguments.createMap().apply { putString("id", spotId) }
+
+  companion object {
+    const val EVENT_NAME = "topSpotPress"
+  }
+}
+
+/** 카메라 이동이 끝났을 때 지도 중심을 JS 로 올려 보낸다. onCameraIdle 로 도착한다. */
+/** 지도의 빈 곳을 눌렀을 때. onMapPress 로 도착한다 (마커를 누른 경우는 오지 않는다) */
+internal class MapPressEvent(surfaceId: Int, viewId: Int) : Event<MapPressEvent>(surfaceId, viewId) {
+  override fun getEventName() = EVENT_NAME
+
+  override fun getEventData(): WritableMap = Arguments.createMap()
+
+  companion object {
+    const val EVENT_NAME = "topMapPress"
+  }
+}
+
+internal class CameraIdleEvent(
+  surfaceId: Int,
+  viewId: Int,
+  private val latitude: Double,
+  private val longitude: Double,
+  private val zoomLevel: Int,
+) : Event<CameraIdleEvent>(surfaceId, viewId) {
+  override fun getEventName() = EVENT_NAME
+
+  // 드래그 한 번에 한 건만 의미가 있어, 아직 전달되지 않은 이전 값은 합쳐 버린다
+  override fun canCoalesce() = true
+
+  override fun getEventData(): WritableMap =
+    Arguments.createMap().apply {
+      putDouble("lat", latitude)
+      putDouble("lng", longitude)
+      putDouble("zoomLevel", zoomLevel.toDouble())
+    }
+
+  companion object {
+    const val EVENT_NAME = "topCameraIdle"
+  }
+}
