+- (void)applySpots:(const std::vector<RNCKakaoMapViewSpotsStruct>&)spots {
+  [_spotLayer clearAllItems];
+  for (NSString* styleID in _spotStyleIDs) [[self.map getLabelManager] removePoiStyle:styleID];
+  [_spotStyleIDs removeAllObjects];
+  UIImage* spotImage = [self markerImage:NO location:NO];
+  UIImage* tourImage = [self markerImage:YES location:NO];
+  for (const auto& spot : spots) {
+    if (!std::isfinite(spot.lat) || !std::isfinite(spot.lng) || fabs(spot.lat) > 90 || fabs(spot.lng) > 180) continue;
+    BOOL tour = spot.kind == "tour";
+    UIImage* pin = tour ? tourImage : spotImage;
+    NSString* name = getNsStr(spot.name);
+    UIFont* font = [UIFont fontWithName:@"SUITE-SemiBold" size:12] ?: [UIFont systemFontOfSize:12 weight:UIFontWeightSemibold];
+    NSMutableParagraphStyle* paragraph = [NSMutableParagraphStyle new];
+    paragraph.alignment = NSTextAlignmentCenter;
+    paragraph.lineBreakMode = NSLineBreakByTruncatingTail;
+    NSDictionary* attributes = @{NSFontAttributeName:font, NSForegroundColorAttributeName:UIColor.blackColor,
+        NSStrokeColorAttributeName:UIColor.whiteColor, NSStrokeWidthAttributeName:@(-3), NSParagraphStyleAttributeName:paragraph};
+    CGSize size = CGSizeMake(MAX(pin.size.width, MIN(160, ceil([name sizeWithAttributes:attributes].width) + 4)), pin.size.height + 20);
+    UIGraphicsImageRenderer* renderer = [[UIGraphicsImageRenderer alloc] initWithSize:size];
+    // SDK 2.10.4's ObjC API has no text-layout setter. Render the label above the pin with the bundled font.
+    UIImage* image = [renderer imageWithActions:^(UIGraphicsImageRendererContext* context) {
+      [name drawInRect:CGRectMake(0, 0, size.width, 16) withAttributes:attributes];
+      [pin drawAtPoint:CGPointMake((size.width - pin.size.width) / 2, 20)];
+    }];
+    NSString* markerID = getNsStr(spot.id);
+    NSString* styleID = [@"fishlog-style:" stringByAppendingString:markerID];
+    CGFloat tip = 20 + pin.size.height * (tour ? 0.5 : 0.856);
+    [self addMarkerStyle:styleID image:image anchor:CGPointMake(0.5, tip / size.height)];
+    [_spotStyleIDs addObject:styleID];
+    PoiOptions* option = [[PoiOptions alloc] initWithStyleID:styleID poiID:markerID];
+    option.clickable = YES;
+    (void)[_spotLayer addPoiWithOption:option at:makePoint(spot.lat, spot.lng) callback:nil];
+  }
+  [_spotLayer showAllPois];
+}
+
+- (void)applyCurrentLocation:(const RNCKakaoMapViewCurrentLocationStruct&)location {
+  if (!isValidNumber(location.lat) || !isValidNumber(location.lng)) {
+    [_locationLayer clearAllItems];
+    _locationPoi = nil;
+    return;
+  }
+  MapPoint* position = makePoint(location.lat, location.lng);
