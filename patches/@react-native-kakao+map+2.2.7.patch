+private const val SPOT_LAYER_ID = "fishlog-spots"
+private const val SPOT_STYLE_ID = "fishlog-spot-pin"
+
+/**
+ * 마커 그림 크기 (Figma 634:1675).
+ *
+ * 찌 자체는 20×32dp 지만 내보낸 그림에는 사방으로 번진 발광이 함께 들어 있어
+ * 시안 크기는 34.38×46.38dp 다. 지도 위에서 커 보여 0.8 배로 줄여 쓴다.
+ * 찌 끝(발광 제외)은 위에서 85.6% 지점이라 비율은 그대로다.
+ */
+private const val SPOT_PIN_WIDTH_DP = 27.5f
+private const val SPOT_PIN_HEIGHT_DP = 37.1f
+private const val SPOT_PIN_TIP_RATIO = 0.856f
+
+/** 시설 이름을 그리기 시작하는 줌. 이보다 넓게 보면 그림만 남는다 (1~20, 클수록 확대) */
