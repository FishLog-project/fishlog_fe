+﻿package net.mjstudio.rnkakao.map
+
+import android.widget.FrameLayout
+import com.facebook.react.bridge.LifecycleEventListener
+import com.facebook.react.uimanager.ThemedReactContext
+import com.kakao.vectormap.KakaoMap
+import com.kakao.vectormap.KakaoMapReadyCallback
+import com.kakao.vectormap.LatLng
+import com.kakao.vectormap.MapLifeCycleCallback
+import com.kakao.vectormap.MapType
+import com.kakao.vectormap.MapView
+import com.kakao.vectormap.PoiScale
+import com.kakao.vectormap.camera.CameraAnimation
+import com.kakao.vectormap.camera.CameraUpdateFactory
+
+internal data class CameraProps(val latitude: Double, val longitude: Double, val zoomLevel: Int)
+
+internal class RNCKakaoMapView(private val reactContext: ThemedReactContext) : FrameLayout(reactContext), LifecycleEventListener {
+  private val nativeMapView = MapView(reactContext)
+  private var kakaoMap: KakaoMap? = null
+  private var camera: CameraProps? = null
+  var cameraAnimationDuration = 0
+
+  var poiEnabled = true
+    set(value) { field = value; kakaoMap?.setPoiVisible(value) }
+  var poiClickable = true
+    set(value) { field = value; kakaoMap?.setPoiClickable(value) }
+  var language = "ko"
+    set(value) { field = value; kakaoMap?.setPoiLanguage(value) }
+  var poiScale = PoiScale.REGULAR
+    set(value) { field = value; kakaoMap?.setPoiScale(value) }
+  var mapType = MapType.NORMAL
+    set(value) { field = value; kakaoMap?.changeMapType(value) }
+  var buildingScale = 1f
+    set(value) { field = value; kakaoMap?.setBuildingHeightScale(value) }
+  var cameraMinLevel = 1
+    set(value) { field = value; kakaoMap?.setCameraMinLevel(value) }
+  var cameraMaxLevel = 20
+    set(value) { field = value; kakaoMap?.setCameraMaxLevel(value) }
+  var showScaleBar = false
+    set(value) { field = value; if (value) kakaoMap?.scaleBar?.show() else kakaoMap?.scaleBar?.hide() }
+  var showCompass = false
+    set(value) { field = value; if (value) kakaoMap?.compass?.show() else kakaoMap?.compass?.hide() }
+
+  init {
+    addView(nativeMapView, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
+    reactContext.addLifecycleEventListener(this)
+    nativeMapView.start(
+      object : MapLifeCycleCallback() {
+        override fun onMapDestroy() = Unit
+        override fun onMapError(error: Exception) = Unit
+      },
+      object : KakaoMapReadyCallback() {
+        override fun onMapReady(map: KakaoMap) {
+          kakaoMap = map
+          applyMapOptions(map)
+          camera?.let(::moveCamera)
+        }
+
+        override fun getPosition(): LatLng = camera?.let { LatLng.from(it.latitude, it.longitude) } ?: super.getPosition()
+        override fun getZoomLevel(): Int = camera?.zoomLevel ?: super.getZoomLevel()
+      },
+    )
+  }
+
+  fun setCamera(value: CameraProps) {
+    camera = value
+    moveCamera(value)
+  }
+
+  private fun moveCamera(value: CameraProps) {
+    val update = CameraUpdateFactory.newCenterPosition(LatLng.from(value.latitude, value.longitude), value.zoomLevel)
+    kakaoMap?.let { map ->
+      if (cameraAnimationDuration > 0) map.moveCamera(update, CameraAnimation.from(cameraAnimationDuration))
+      else map.moveCamera(update)
+    }
+  }
+
+  private fun applyMapOptions(map: KakaoMap) {
+    map.setPoiVisible(poiEnabled)
+    map.setPoiClickable(poiClickable)
+    map.setPoiLanguage(language)
+    map.setPoiScale(poiScale)
+    map.changeMapType(mapType)
+    map.setBuildingHeightScale(buildingScale)
+    map.setCameraMinLevel(cameraMinLevel)
+    map.setCameraMaxLevel(cameraMaxLevel)
+    if (showScaleBar) map.scaleBar?.show() else map.scaleBar?.hide()
+    if (showCompass) map.compass?.show() else map.compass?.hide()
+  }
+
+  override fun onHostResume() = nativeMapView.resume()
+  override fun onHostPause() = nativeMapView.pause()
+  override fun onHostDestroy() = destroy()
+
+  fun destroy() {
+    reactContext.removeLifecycleEventListener(this)
+    nativeMapView.finish()
+    kakaoMap = null
+  }
+}
+
