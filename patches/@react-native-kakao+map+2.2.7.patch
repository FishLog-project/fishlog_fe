+﻿package net.mjstudio.rnkakao.map
+
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.widget.FrameLayout
+import com.facebook.react.bridge.LifecycleEventListener
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.WritableMap
+import com.facebook.react.uimanager.ThemedReactContext
+import com.facebook.react.uimanager.UIManagerHelper
+import com.facebook.react.uimanager.events.Event
+import com.kakao.vectormap.KakaoMap
+import com.kakao.vectormap.KakaoMapReadyCallback
+import com.kakao.vectormap.LatLng
+import com.kakao.vectormap.MapLifeCycleCallback
+import com.kakao.vectormap.MapGravity
+import com.kakao.vectormap.MapType
+import com.kakao.vectormap.MapView
+import com.kakao.vectormap.PoiScale
+import com.kakao.vectormap.camera.CameraAnimation
+import com.kakao.vectormap.camera.CameraUpdateFactory
+import com.kakao.vectormap.label.Label
+import com.kakao.vectormap.label.LabelLayer
+import com.kakao.vectormap.label.LabelLayerOptions
+import com.kakao.vectormap.label.LabelOptions
+import com.kakao.vectormap.label.LabelStyle
+import com.kakao.vectormap.label.LabelStyles
+import com.kakao.vectormap.label.LabelTextBuilder
+import com.kakao.vectormap.label.LabelTextStyle
+
+internal data class CameraProps(val latitude: Double, val longitude: Double, val zoomLevel: Int)
+
+internal data class LatLngProps(val latitude: Double, val longitude: Double)
+
+internal data class SpotProps(
+  val id: Int,
+  val name: String,
+  val latitude: Double,
+  val longitude: Double,
+)
+
+/** 마커를 눌렀을 때 JS 로 올려 보내는 이벤트. onSpotPress 로 도착한다. */
+internal class SpotPressEvent(surfaceId: Int, viewId: Int, private val spotId: Int) :
+  Event<SpotPressEvent>(surfaceId, viewId) {
+  override fun getEventName() = EVENT_NAME
+
+  override fun getEventData(): WritableMap = Arguments.createMap().apply { putInt("id", spotId) }
+
+  companion object {
+    const val EVENT_NAME = "topSpotPress"
+  }
+}
+
+internal class RNCKakaoMapView(private val reactContext: ThemedReactContext) : FrameLayout(reactContext), LifecycleEventListener {
+  private val nativeMapView = MapView(reactContext)
+  private var kakaoMap: KakaoMap? = null
+  private var camera: CameraProps? = null
+  private var currentLocation: LatLngProps? = null
+  private var currentLocationLabel: Label? = null
+  private var spots: List<SpotProps> = emptyList()
+  private var spotLayer: LabelLayer? = null
+  private var spotStyles: LabelStyles? = null
+  var cameraAnimationDuration = 0
+
+  var poiEnabled = true
+    set(value) { field = value; kakaoMap?.setPoiVisible(value) }
+  var poiClickable = true
+    set(value) { field = value; kakaoMap?.setPoiClickable(value) }
+  var language = "ko"
+    set(value) { field = value; kakaoMap?.setPoiLanguage(value) }
+  var poiScale = PoiScale.REGULAR
+    set(value) { field = value; kakaoMap?.setPoiScale(value) }
+  var mapType = MapType.NORMAL
+    set(value) { field = value; kakaoMap?.changeMapType(value) }
+  var buildingScale = 1f
+    set(value) { field = value; kakaoMap?.setBuildingHeightScale(value) }
+  var cameraMinLevel = 1
+    set(value) { field = value; kakaoMap?.setCameraMinLevel(value) }
+  var cameraMaxLevel = 20
+    set(value) { field = value; kakaoMap?.setCameraMaxLevel(value) }
+  var showScaleBar = false
+    set(value) { field = value; if (value) kakaoMap?.scaleBar?.show() else kakaoMap?.scaleBar?.hide() }
+  var showCompass = false
+    set(value) { field = value; if (value) kakaoMap?.compass?.show() else kakaoMap?.compass?.hide() }
+
+  init {
+    addView(nativeMapView, LayoutParams(LayoutParams.MATCH_PARENT, LayoutParams.MATCH_PARENT))
+    reactContext.addLifecycleEventListener(this)
+    nativeMapView.start(
+      object : MapLifeCycleCallback() {
+        override fun onMapDestroy() = Unit
+        override fun onMapError(error: Exception) = Unit
+      },
+      object : KakaoMapReadyCallback() {
+        override fun onMapReady(map: KakaoMap) {
+          kakaoMap = map
+          spotLayer = null
+          spotStyles = null
+          applyMapOptions(map)
+          camera?.let(::moveCamera)
+          map.setOnLabelClickListener { _, _, label ->
+            (label.tag as? Int)?.let(::emitSpotPress)
+          }
+          applyCurrentLocation()
+          applySpots()
+        }
+
+        override fun getPosition(): LatLng = camera?.let { LatLng.from(it.latitude, it.longitude) } ?: super.getPosition()
+        override fun getZoomLevel(): Int = camera?.zoomLevel ?: super.getZoomLevel()
+      },
+    )
+  }
+
+  fun setCamera(value: CameraProps) {
+    camera = value
+    moveCamera(value)
+  }
+
+  fun setCurrentLocation(value: LatLngProps?) {
+    currentLocation = value
+    applyCurrentLocation()
+  }
+
+  fun setSpots(value: List<SpotProps>) {
+    spots = value
+    applySpots()
+  }
+
+  /**
+   * 낚시 스팟 마커를 다시 그린다.
+   *
+   * 현재 위치와 레이어를 분리한다 — 목록이 바뀔 때마다 removeAll 로 지우는데,
+   * 같은 레이어를 쓰면 현재 위치 마커까지 함께 지워지기 때문이다.
+   * 각 라벨의 tag 에 스팟 id 를 넣어 두고, 클릭 때 그 값을 그대로 올려 보낸다.
+   */
+  private fun applySpots() {
+    val map = kakaoMap ?: return
+    val labelManager = map.labelManager ?: return
+
+    val layer =
+      spotLayer
+        ?: labelManager
+          .addLayer(LabelLayerOptions.from(SPOT_LAYER_ID).apply { clickable = true })
+          ?.also { spotLayer = it }
+        ?: return
+
+    layer.removeAll()
+    if (spots.isEmpty()) return
+
+    // 마커 아이콘은 목록이 바뀔 때마다 다시 그릴 필요가 없다 (검색 한 글자마다 호출된다)
+    val styles =
+      spotStyles
+        ?: labelManager
+          .addLabelStyles(LabelStyles.from(SPOT_STYLE_ID, createSpotStyle()))
+          ?.also { spotStyles = it }
+        ?: return
+
+    layer.addLabels(
+      spots.map { spot ->
+        LabelOptions
+          .from(LatLng.from(spot.latitude, spot.longitude))
+          .setStyles(styles)
+          .setTexts(LabelTextBuilder().setTexts(spot.name))
+          .setClickable(true)
+          .setTag(spot.id)
+      },
+    )
+  }
+
+  private fun emitSpotPress(spotId: Int) {
+    val dispatcher = UIManagerHelper.getEventDispatcherForReactTag(reactContext, id) ?: return
+    dispatcher.dispatchEvent(SpotPressEvent(UIManagerHelper.getSurfaceId(reactContext), id, spotId))
+  }
+
+  /**
+   * 마커 한 벌 — 낚시찌 그림 + 그 위에 얹는 낚시터 이름 (Figma 634:1675).
+   *
+   * dp 보정을 끄고 픽셀 값을 직접 넘긴다. 켜 두면 그림은 그대로인데 글자만 한 번 더
+   * 확대돼 둘의 비율이 시안과 달라진다.
+   */
+  private fun createSpotStyle(): LabelStyle {
+    val density = resources.displayMetrics.density
+
+    return LabelStyle
+      .from(createSpotPin())
+      .setApplyDpScale(false)
+      // 그림의 아래쪽 15%는 발광이 번진 여백이라, 찌 끝이 좌표에 닿도록 위로 당긴다
+      .setAnchorPoint(0.5f, SPOT_PIN_TIP_RATIO)
+      // 시안에 없는 흰 테두리를 한 겹 준다 — 지도 위 짙은 면에서는 검은 글자만으론 안 읽힌다
+      .setTextStyles(
+        LabelTextStyle.from(
+          (SPOT_LABEL_SIZE_DP * density).toInt(),
+          Color.rgb(28, 28, 28),
+          density.toInt().coerceAtLeast(1),
+          Color.WHITE,
+        ),
+      )
+      .setTextGravity(MapGravity.TOP)
+      .setPadding(SPOT_LABEL_GAP_DP * density)
+  }
+
+  /**
+   * 낚시찌 마커 (Figma 634:1675).
+   *
+   * 발광까지 들어간 그림이라 Canvas 로 다시 그리지 않고 내보낸 PNG 를 쓴다.
+   * drawable 은 with-spot-marker-drawable 플러그인이 prebuild 때 넣어 준다.
+   */
+  private fun createSpotPin(): Bitmap {
+    val density = resources.displayMetrics.density
+    val width = (SPOT_PIN_WIDTH_DP * density).toInt().coerceAtLeast(1)
+    val height = (SPOT_PIN_HEIGHT_DP * density).toInt().coerceAtLeast(1)
+    val resId = resources.getIdentifier("spot_marker", "drawable", context.packageName)
+    val source = if (resId == 0) null else BitmapFactory.decodeResource(resources, resId)
+
+    // 그림을 못 찾아도 지도는 계속 보여 준다 — 마커만 단색 원으로 대신한다
+    if (source == null) return createFallbackPin(width, height)
+
+    return Bitmap.createScaledBitmap(source, width, height, true)
+  }
+
+  private fun createFallbackPin(
+    width: Int,
+    height: Int,
+  ): Bitmap {
+    val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+    val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.rgb(0, 124, 206) }
+    Canvas(bitmap).drawCircle(width / 2f, width / 2f, width / 2f - 1f, paint)
+    return bitmap
+  }
+
+  /** 현재 위치 라벨을 지도에 올린다. 이미 올라와 있으면 위치만 옮긴다. */
+  private fun applyCurrentLocation() {
+    val map = kakaoMap ?: return
+    val position = currentLocation
+
+    if (position == null) {
+      currentLocationLabel?.remove()
+      currentLocationLabel = null
+      return
+    }
+
+    val point = LatLng.from(position.latitude, position.longitude)
+    currentLocationLabel?.let {
+      it.moveTo(point)
+      return
+    }
+
+    val labelManager = map.labelManager ?: return
+    val layer = labelManager.layer ?: return
+    val styles = labelManager.addLabelStyles(LabelStyles.from(LabelStyle.from(createLocationDot()))) ?: return
+    currentLocationLabel = layer.addLabel(LabelOptions.from(point).setStyles(styles))
+  }
+
+  /** 드로어블 리소스 없이 현재 위치 점을 그린다. 색은 Fishlog 메인 블루(#00A0F0). */
+  private fun createLocationDot(): Bitmap {
+    val density = resources.displayMetrics.density
+    val size = (24 * density).toInt().coerceAtLeast(1)
+    val bitmap = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
+    val canvas = Canvas(bitmap)
+    val center = size / 2f
+    val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    paint.color = Color.argb(56, 0, 160, 240)
+    canvas.drawCircle(center, center, center, paint)
+    paint.color = Color.WHITE
+    canvas.drawCircle(center, center, 7f * density, paint)
+    paint.color = Color.rgb(0, 160, 240)
+    canvas.drawCircle(center, center, 5f * density, paint)
+
+    return bitmap
+  }
+
+  private fun moveCamera(value: CameraProps) {
+    val update = CameraUpdateFactory.newCenterPosition(LatLng.from(value.latitude, value.longitude), value.zoomLevel)
+    kakaoMap?.let { map ->
+      if (cameraAnimationDuration > 0) map.moveCamera(update, CameraAnimation.from(cameraAnimationDuration))
+      else map.moveCamera(update)
+    }
+  }
+
+  private fun applyMapOptions(map: KakaoMap) {
+    map.setPoiVisible(poiEnabled)
+    map.setPoiClickable(poiClickable)
+    map.setPoiLanguage(language)
+    map.setPoiScale(poiScale)
+    map.changeMapType(mapType)
+    map.setBuildingHeightScale(buildingScale)
+    map.setCameraMinLevel(cameraMinLevel)
+    map.setCameraMaxLevel(cameraMaxLevel)
+    if (showScaleBar) map.scaleBar?.show() else map.scaleBar?.hide()
+    if (showCompass) map.compass?.show() else map.compass?.hide()
+  }
+
+  override fun onHostResume() = nativeMapView.resume()
+  override fun onHostPause() = nativeMapView.pause()
+  override fun onHostDestroy() = destroy()
+
+  fun destroy() {
+    reactContext.removeLifecycleEventListener(this)
+    nativeMapView.finish()
+    currentLocationLabel = null
+    spotLayer = null
+    spotStyles = null
+    kakaoMap = null
+  }
+}
+
+private const val SPOT_LAYER_ID = "fishlog-spots"
+private const val SPOT_STYLE_ID = "fishlog-spot-pin"
+
+/**
+ * 마커 그림 크기 (Figma 634:1675).
+ *
+ * 찌 자체는 20×32dp 지만 내보낸 그림에는 사방으로 번진 발광이 함께 들어 있어
+ * 34.38×46.38dp 다. 찌 끝(발광 제외)은 위에서 85.6% 지점이다.
+ */
+private const val SPOT_PIN_WIDTH_DP = 34.38f
+private const val SPOT_PIN_HEIGHT_DP = 46.38f
+private const val SPOT_PIN_TIP_RATIO = 0.856f
+
+/** 마커 위 낚시터 이름 — SUITE SemiBold 12 / 그림과의 간격 4 */
+private const val SPOT_LABEL_SIZE_DP = 12f
+private const val SPOT_LABEL_GAP_DP = 4f
