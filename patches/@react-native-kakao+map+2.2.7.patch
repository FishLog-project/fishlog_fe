+- (UIImage*)markerImage:(BOOL)tour location:(BOOL)location {
+  CGSize size = location ? CGSizeMake(24, 24) : tour ? CGSizeMake(28, 28) : CGSizeMake(34.38, 46.38);
+  UIGraphicsImageRenderer* renderer = [[UIGraphicsImageRenderer alloc] initWithSize:size];
+  return [renderer imageWithActions:^(UIGraphicsImageRendererContext* context) {
+    UIImage* source = tour || location ? nil : [UIImage imageNamed:@"spot_marker"];
+    if (source) { [source drawInRect:(CGRect){CGPointZero, size}]; return; }
+    UIColor* color = location ? [UIColor colorWithRed:0 green:0.63 blue:0.94 alpha:1]
+                             : [UIColor colorWithRed:0 green:0.58 blue:0.52 alpha:1];
+    CGRect circle = CGRectMake(0, 0, size.width, size.width);
+    [(location ? [color colorWithAlphaComponent:0.22] : UIColor.whiteColor) setFill];
+    [[UIBezierPath bezierPathWithOvalInRect:circle] fill];
+    [UIColor.whiteColor setFill];
+    [[UIBezierPath bezierPathWithOvalInRect:CGRectInset(circle, location ? 5 : 0, location ? 5 : 0)] fill];
+    [color setFill];
+    [[UIBezierPath bezierPathWithOvalInRect:CGRectInset(circle, location ? 7 : 2, location ? 7 : 2)] fill];
+    if (!location) {
+      [UIColor.whiteColor setFill];
+      [[UIBezierPath bezierPathWithOvalInRect:CGRectMake(size.width / 2 - 4, size.width / 2 - 4, 8, 8)] fill];
+    }
+  }];
+}
