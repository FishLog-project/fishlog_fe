+      transition:PoiTransition{TransitionTypeNone, TransitionTypeNone}
+      enableEntranceTransition:NO enableExitTransition:NO badges:nil];
+  PerLevelPoiStyle* level = [[PerLevelPoiStyle alloc] initWithIconStyle:icon padding:0 level:1];
+  [[self.map getLabelManager] addPoiStyle:[[PoiStyle alloc] initWithStyleID:styleID styles:@[level]]];
+}
